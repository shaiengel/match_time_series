{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Banded: Default (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/banded_dtw.py",
            "args": ["--band-width", "200", "--save-plot", "dtw_banded.png",
            "--prefix", "154556.pre-fix.txt", "--corrected", "154556.txt"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Banded: Swap (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/banded_dtw.py",
