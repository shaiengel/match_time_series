            "--prefix", "154556.pre-fix.txt", "--corrected", "154556.txt"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "DTW: Chunked (10 words)",
            "type": "debugpy",
