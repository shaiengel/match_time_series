{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Banded: Default (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/banded_dtw.py",
            "args": ["--band-width", "200", "--save-plot",
            "--prefix", "input/151913.pre-fix.txt", "--corrected", "input/151913.txt"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Banded: Swap (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/banded_dtw.py",
            "args": ["--band-width", "200", "--save-plot", "--swap", "--chunk-size", "5",
            "--prefix", "input/151913.pre-fix.txt", "--corrected", "input/151913.txt"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Probability Analysis",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/probability_analysis.py",
            "args": ["input/151448.json", "--ma-window", "100", "--target", "0.25"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "DTW: Chunked (10 words)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "chunked", "--chunk-size", "10", "--search-window", "10", "--save-plot", "dtw_chunked.png"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },        
        {
            "name": "DTW: Banded (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "banded", "--band-width", "200", "--save-plot", "dtw_banded.png",
            "--prefix", "input/306013.pre-fix.txt", "--corrected", "input/306013.txt"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "DTW: Banded swap (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "banded", "--band-width", "200", "--save-plot", "dtw_banded.png", "--swap", "--chunk-size", "5"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "DTW: Global Mode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "global", "--save-plot", "dtw_global.png"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "DTW: Subsequence Mode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--mode", "subsequence", "--save-plot", "dtw_subseq.png", "--swap"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },        
        {
            "name": "DTW: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
