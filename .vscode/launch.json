            "--prefix", "306013.pre-fix.txt", "--corrected", "306013.txt"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "DTW: Banded swap (width=200)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
